le="color:#575b5f;font-size:10.5pt">&nbsp; &nbsp; </span><span style="color:#5f6368;font-size:10.5pt"># If it's False, the test fails.</span></p><p style="padding:0;margin:0;color:#000000;font-size:11pt;font-family:&quot;Arial&quot;;line-height:1.15;orphans:2;widows:2;text-align:left"><span style="color:#575b5f;font-size:10.5pt">&nbsp; &nbsp; </span><span style="color:#8430ce;font-size:10.5pt">assert</span><span style="color:#575b5f;font-size:10.5pt">&nbsp;add(</span><span style="color:#b55908;font-size:10.5pt">2</span><span style="color:#575b5f;font-size:10.5pt">, </span><span style="color:#b55908;font-size:10.5pt">3</span><span style="color:#575b5f;font-size:10.5pt">) == </span><span style="color:#b55908;font-size:10.5pt">5</span></p><p style="padding:0;margin:0;color:#000000;font-size:11pt;font-family:&quot;Arial&quot;;line-height:1.15;orphans:2;widows:2;height:11pt;text-align:left"><span style="color:#575b5f;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:10.5pt;font-family:&quot;Arial&quot;;font-style:normal"></span></p><p style="padding:0;margin:0;color:#000000;font-size:11pt;font-family:&quot;Arial&quot;;line-height:1.15;orphans:2;widows:2;text-align:left"><span style="color:#8430ce;font-size:10.5pt">def</span><span style="color:#575b5f;font-size:10.5pt">&nbsp;</span><span style="color:#996900;font-size:10.5pt">test_add_negative_numbers</span><span style="color:#575b5f;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:10.5pt;font-family:&quot;Arial&quot;;font-style:normal">():</span></p><p style="padding:0;margin:0;color:#000000;font-size:11pt;font-family:&quot;Arial&quot;;line-height:1.15;orphans:2;widows:2;text-align:left"><span style="color:#575b5f;font-size:10.5pt">&nbsp; &nbsp; </span><span style="color:#8430ce;font-size:10.5pt">assert</span><span style="color:#575b5f;font-size:10.5pt">&nbsp;add(-</span><span style="color:#b55908;font-size:10.5pt">1</span><span style="color:#575b5f;font-size:10.5pt">, -</span><