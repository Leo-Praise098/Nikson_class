:10.5pt">not</span><span style="color:#575b5f;font-size:10.5pt">&nbsp;</span><span style="color:#8430ce;font-size:10.5pt">in</span><span style="color:#575b5f;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:10.5pt;font-family:&quot;Arial&quot;;font-style:normal">&nbsp;data:</span></p><p style="padding:0;margin:0;color:#000000;font-size:11pt;font-family:&quot;Arial&quot;;line-height:1.15;orphans:2;widows:2;text-align:left"><span style="color:#575b5f;font-size:10.5pt">&nbsp; &nbsp; &nbsp; &nbsp; </span><span style="color:#8430ce;font-size:10.5pt">return</span><span style="color:#575b5f;font-size:10.5pt">&nbsp;jsonify({</span><span style="color:#188038;font-size:10.5pt">"error"</span><span style="color:#575b5f;font-size:10.5pt">: </span><span style="color:#188038;font-size:10.5pt">"Missing title"</span><span style="color:#575b5f;font-size:10.5pt">}), </span><span style="color:#b55908;font-size:10.5pt">400</span></p><p style="padding:0;margin:0;color:#000000;font-size:11pt;font-family:&quot;Arial&quot;;line-height:1.15;orphans:2;widows:2;height:11pt;text-align:left"><span style="color:#575b5f;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:10.5pt;font-family:&quot;Arial&quot;;font-style:normal"></span></p><p style="padding:0;margin:0;color:#000000;font-size:11pt;font-family:&quot;Arial&quot;;line-height:1.15;orphans:2;widows:2;text-align:left"><span style="color:#575b5f;font-size:10.5pt">&nbsp; &nbsp; </span><span style="color:#5f6368;font-size:10.5pt"># Create a new Task object (a new row)</span></p><p style="padding:0;margin:0;color:#000000;font-size:11pt;font-family:&quot;Arial&quot;;line-height:1.15;orphans:2;widows:2;text-align:left"><span style="color:#575b5f;font-size:10.5pt">&nbsp; &nbsp; new_task = Task(title=data[</span><span style="color:#188038;font-size:10.5pt">'title'</span><span style="color:#575b5f;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:10.5pt;font-family:&quot;Arial&quot;;font-style:normal">])</span></p><p style="padding:0;margin:0;color:#000000;font-size:11pt;font-family:&quot;Arial&quot;;line-height:1.15;orphans:2;widows:2;text-align:left"><span style="color:#575b5f;font-size:10.5pt">&nbsp; &nbsp; </span><span style="color:#5f6368;font-size:10.5pt"># Add the new object to the database session</span></p><p style="padding:0;margin:0;color:#000000;font-size:11pt;font-family:&quot;Arial&quot;;line-height:1.15;orphans:2;widows:2;text-align:left"><span style="color:#575b5f;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:10.5pt;font-family:&quot;Arial&quot;;font-style:normal">&nbsp; &nbsp; db.session.add(new_task)</span></p><p style="padding:0;margin:0;color:#000000;font-size:11pt;font-family:&quot;Arial&quot;;line-height:1.15;orphans:2;widows:2;text-align:left"><span style="color:#575b5f;font-size:10.5pt">&nbsp; &nbsp; </span><span style="color:#5f6368;font-size:10.5pt"># Commit the session to save the changes to the database</span></p><p style="padding:0;margin:0;color:#000000;font-size:11pt;font-family:&quot;Arial&quot;;line-height:1.15;orphans:2;widows:2;text-align:left"><span style="color:#575b5f;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:10.5pt;font-family:&quot;Arial&quot;;font-style:normal">&nbsp; &nbsp; db.session.commit()</span></p><p style="padding:0;margin:0;color:#000000;font-size:11pt;font-family:&quot;Arial&quot;;line-height:1.15;orphans:2;widows:2;height:11pt;text-align:left"><span style="color:#575b5f;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:10.5pt;font-family:&quot;Arial&quot;;font-style:normal"></span></p><p style="padding:0;margin:0;color:#000000;font-size:11pt;font-family:&quot;Arial&quot;;line-height:1.15;orphans:2;widows:2;text-align:left"><span style="color:#575b5f;font-size:10.5pt">&nbsp; &nbsp; </span><span style="color:#8430ce;font-size:10.5pt">return</span><span style="color:#575b5f;font-size:10.5pt">&nbsp;jsonify(new_task.to_dict()), </span><span style="color:#b55908;font-size:10.5pt">201</span></p><p style="padding-top:0pt;margin:0;color:#000000;padding-left:0;font-size:11pt;padding-bottom:12pt;line-height:1.15;background-color:#f0f4f9;font-family:&quot;Arial&quot;;orphans:2;widows:2;height:11pt;text-align:left;padding-right:0"><span style="color:#575b5f;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:10.5pt;font-family:&quot;Arial&quot;;font-style:normal"></span></p><p style="padding-top:0pt;margin:0;color:#000000;padding-left:0;font-size:11pt;padding-bottom:12pt;font-family:&quot;Arial&quot;;line-height:1.15;orphans:2;widows:2;text-align:left;padding-right:0"><span style="color:#1b1c1d;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal">This completes the full-stack loop: an HTTP request comes in, Flask routes it to a function, the function uses the ORM to interact with the database, and the result is converted to JSON and sent back as an HTTP response. This is the foundation of a modern web backend.</span></p><hr><p style="padding:0;margin:0;color:#000000;font-size:11pt;font-family:&quot;Arial&quot;;line-height:1.15;orphans:2;widows:2;height:11pt;text-align:left"><span style="color:#1b1c1d;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal"></span></p><h3 id="h.a9cmjnwf11q0" style="padding-top:0pt;margin:0;color:#434343;padding-left:0;font-size:14pt;padding-bottom:6pt;line-height:1.15;page-break-after:avoid;font-family:&quot;Arial&quot;;orphans:2;widows:2;text-align:left;padding-right:0"><span style="color:#1b1c1d;font-weight:700;text-decoration:none;vertical-align:baseline;font-size:13pt;font-family:&quot;Arial&quot;;font-style:normal">Further Research</span></h3><ul class="lst-kix_q9fck26564dd-0 start" style="padding:0;margin:0"><li style="padding-top:0pt;color:#000000;padding-left:0pt;font-size:11pt;padding-bottom:18pt;line-height:1.15;margin-right:0;margin-left:36pt;font-family:&quot;Arial&quot;;margin-top:0;orphans:2;margin-bottom:0;widows:2;text-align:left;padding-right:0"><span style="color:#1b1c1d;font-weight:700">Mega-Tutorial Part IV: Database (by Miguel Grinberg):</span><span style="color:#1b1c1d"><a href="https://www.google.com/url?q=https://blog.miguelgrinberg.com/post/the-flask-mega-tutorial-part-iv-database&amp;sa=D&amp;source=editors&amp;ust=1786364336276014&amp;usg=AOvVaw2QKkH8s6ZW0M3eX7B9jBK6" style="color:inherit;text-decoration:inherit">&nbsp;</a></span><span style="text-decoration-skip-ink:none;-webkit-text-decoration-skip:none;color:#0b57d0;text-decoration:underline"><a href="https://www.google.com/url?q=https://blog.miguelgrinberg.com/post/the-flask-mega-tutorial-part-iv-database&amp;sa=D&amp;source=editors&amp;ust=1786364336276163&amp;usg=AOvVaw3y365jG-vgySEwR0VWQT9J" style="color:inherit;text-decoration:inherit">https://blog.miguelgrinberg.com/post/the-flask-mega-tutorial-part-iv-database</a></span><span style="color:#1b1c1d;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal">&nbsp;(An excellent, in-depth tutorial)</span></li><li style="padding-top:0pt;color:#000000;padding-left:0pt;font-size:11pt;padding-bottom:18pt;line-height:1.15;margin-right:0;margin-left:36pt;font-family:&quot;Arial&quot;;margin-top:0;orphans:2;margin-bottom:0;widows:2;text-align:left;padding-right:0"><span style="color:#1b1c1d;font-weight:700">Model-View-Controller (MVC) Architecture:</span><span style="color:#1b1c1d"><a href="https://www.google.com/url?q=https://www.geeksforgeeks.org/mvc-framework-introduction/&amp;sa=D&amp;source=editors&amp;ust=1786364336276321&amp;usg=AOvVaw0imnylCxTP3P8ZFIkyjBeM" style="color:inherit;text-decoration:inherit">&nbsp;</a></span><span style="text-decoration-skip-ink:none;-webkit-text-decoration-skip:none;color:#0b57d0;text-decoration:underline"><a href="https://www.google.com/url?q=https://www.geeksforgeeks.org/mvc-framework-introduction/&amp;sa=D&amp;source=editors&amp;ust=1786364336276421&amp;usg=AOvVaw00RF4oHO8BN2jcNE44GmAo" style="color:inherit;text-decoration:inherit">https://www.geeksforgeeks.org/mvc-framework-introduction/</a></span><span style="color:#1b1c1d;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal">&nbsp;(Learn about the design pattern that frameworks like Flask and Django are based on. Flask is more Model-View-Template, where the route function acts as the Controller.)</span></li></ul><p style="padding:0;margin:0;color:#000000;font-size:11pt;font-family:&quot;Arial&quot;;line-height:1.15;orphans:2;widows:2;height:11pt;text-align:left"><span style="color:#000000;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal"></span></p><p class="title" id="h.rwkwf09hzap3" style="padding:0;margin:0;color:#000000;font-size:26pt;font-family:&quot;Arial&quot;;line-height:1.15;page-break-after:avoid;orphans:2;widows:2;text-align:left"><span style="color:#000000;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:26pt;font-family:&quot;Arial&quot;;font-style:normal">Module 6: Testing &amp; Types of Tests</span></p><h2 id="h.30pm4k6qcn41" style="padding-top:0pt;margin:0;color:#000000;padding-left:0;font-size:16pt;padding-bottom:6pt;line-height:1.15;page-break-after:avoid;font-family:&quot;Arial&quot;;orphans:2;widows:2;text-align:left;padding-right:0"><span style="color:#1b1c1d;font-weight:700;text-decoration:none;vertical-align:baseline;font-size:17pt;font-family:&quot;Arial&quot;;font-style:normal">Week 1: The Importance of Testing &amp; Types of Tests</span></h2><p style="padding-top:0pt;margin:0;color:#000000;padding-left:0;font-size:11pt;padding-bottom:12pt;font-family:&quot;Arial&quot;;line-height:1.15;orphans:2;widows:2;text-align:left;padding-right:0"><span style="color:#1b1c1d">This week, you'll learn </span><span style="color:#1b1c1d;font-style:italic">why</span><span style="color:#1b1c1d;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal">&nbsp;professional software engineers spend so much time writing tests. Writing tests isn't just about finding bugs; it's about building robust, maintainable, and reliable software.</span></p><h3 id="h.fi3kscb7n2kf" style="padding-top:0pt;margin:0;color:#434343;padding-left:0;font-size:14pt;padding-bottom:6pt;line-height:1.15;page-break-after:avoid;font-family:&quot;Arial&quot;;orphans:2;widows:2;text-align:left;padding-right:0"><span style="color:#1b1c1d;font-weight:700;text-decoration:none;vertical-align:baseline;font-size:13pt;font-family:&quot;Arial&quot;;font-style:normal">Why Do We Write Automated Tests?</span></h3><ol class="lst-kix_ftr6m5qa4cb5-0 start" start="1" style="padding:0;margin:0"><li style="padding-top:0pt;color:#000000;padding-left:0pt;font-size:11pt;padding-bottom:18pt;line-height:1.15;margin-right:0;margin-left:36pt;font-family:&quot;Arial&quot;;margin-top:0;orphans:2;margin-bottom:0;widows:2;text-align:left;padding-right:0"><span style="color:#1b1c1d;font-weight:700">Confidence to Change Code (Refactoring):</span><span style="color:#1b1c1d;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal">&nbsp;A good test suite acts as a safety net. You can confidently make changes or improvements (refactor) to your code, and if you accidentally break something, your tests will fail, telling you exactly what went wrong.</span></li><li style="padding-top:0pt;color:#000000;padding-left:0pt;font-size:11pt;padding-bottom:18pt;line-height:1.15;margin-right:0;margin-left:36pt;font-family:&quot;Arial&quot;;margin-top:0;orphans:2;margin-bottom:0;widows:2;text-align:left;padding-right:0"><span style="color:#1b1c1d;font-weight:700">Acts as Documentation:</span><span style="color:#1b1c1d;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal">&nbsp;A well-written test clearly demonstrates how a piece of code is intended to be used. It's living, verifiable documentation.</span></li><li style="padding-top:0pt;color:#000000;padding-left:0pt;font-size:11pt;padding-bottom:18pt;line-height:1.15;margin-right:0;margin-left:36pt;font-family:&quot;Arial&quot;;margin-top:0;orphans:2;margin-bottom:0;widows:2;text-align:left;padding-right:0"><span style="color:#1b1c1d;font-weight:700">Improves Code Design:</span><span style="color:#1b1c1d;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal">&nbsp;To make code testable, you often have to write smaller, more focused functions. This naturally leads to better-designed, more modular code.</span></li><li style="padding-top:0pt;color:#000000;padding-left:0pt;font-size:11pt;padding-bottom:18pt;line-height:1.15;margin-right:0;margin-left:36pt;font-family:&quot;Arial&quot;;margin-top:0;orphans:2;margin-bottom:0;widows:2;text-align:left;padding-right:0"><span style="color:#1b1c1d;font-weight:700">Reduces Bugs:</span><span style="color:#1b1c1d;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal">&nbsp;This is the obvious one. Automated tests catch bugs early in the development process, long before they reach users.</span></li></ol><h3 id="h.dwtp5hlvj6v8" style="padding-top:0pt;margin:0;color:#434343;padding-left:0;font-size:14pt;padding-bottom:6pt;line-height:1.15;page-break-after:avoid;font-family:&quot;Arial&quot;;orphans:2;widows:2;text-align:left;padding-right:0"><span style="color:#1b1c1d;font-weight:700;text-decoration:none;vertical-align:baseline;font-size:13pt;font-family:&quot;Arial&quot;;font-style:normal">The Testing Pyramid</span></h3><p style="padding-top:0pt;margin:0;color:#000000;padding-left:0;font-size:11pt;padding-bottom:6pt;font-family:&quot;Arial&quot;;line-height:1.15;orphans:2;widows:2;text-align:left;padding-right:0"><span style="color:#1b1c1d">Not all tests are created equal. The </span><span style="color:#1b1c1d;font-weight:700">Testing Pyramid</span><span style="color:#1b1c1d;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal">&nbsp;is a model for a healthy testing strategy. You should have a lot of small, fast tests at the bottom and a few large, slow tests at the top.</span></p><ul class="lst-kix_iw3301jms20c-0 start" style="padding:0;margin:0"><li style="padding-top:0pt;color:#000000;padding-left:0pt;font-size:11pt;padding-bottom:18pt;line-height:1.15;margin-right:0;margin-left:36pt;font-family:&quot;Arial&quot;;margin-top:0;orphans:2;margin-bottom:0;widows:2;text-align:left;padding-right:0"><span style="color:#1b1c1d;font-weight:700;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal">Unit Tests (The Foundation):</span></li></ul><ul class="lst-kix_iw3301jms20c-1 start" style="padding:0;margin:0"><li style="padding-top:0pt;color:#000000;padding-left:0pt;font-size:11pt;padding-bottom:30pt;line-height:1.15;margin-right:0;margin-left:72pt;font-family:&quot;Arial&quot;;margin-top:0;orphans:2;margin-bottom:0;widows:2;text-align:left;padding-right:0"><span style="color:#1b1c1d;font-weight:700">What:</span><span style="color:#1b1c1d;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal">&nbsp;Tests a single, isolated "unit" of code, usually a function or a method on a class.</span></li><li style="padding-top:0pt;color:#000000;padding-left:0pt;font-size:11pt;padding-bottom:30pt;line-height:1.15;margin-right:0;margin-left:72pt;font-family:&quot;Arial&quot;;margin-top:0;orphans:2;margin-bottom:0;widows:2;text-align:left;padding-right:0"><span style="color:#1b1c1d;font-weight:700">Goal:</span><span style="color:#1b1c1d;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal">&nbsp;To verify that the unit works correctly in isolation.</span></li><li style="padding-top:0pt;color:#000000;padding-left:0pt;font-size:11pt;padding-bottom:30pt;line-height:1.15;margin-right:0;margin-left:72pt;font-family:&quot;Arial&quot;;margin-top:0;orphans:2;margin-bottom:0;widows:2;text-align:left;padding-right:0"><span style="color:#1b1c1d;font-weight:700">Characteristics:</span><span style="color:#1b1c1d;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal">&nbsp;Very fast, cheap to write, and make up the majority of your tests.</span></li></ul><ul class="lst-kix_iw3301jms20c-0" style="padding:0;margin:0"><li style="padding-top:0pt;color:#000000;padding-left:0pt;font-size:11pt;padding-bottom:18pt;line-height:1.15;margin-right:0;margin-left:36pt;font-family:&quot;Arial&quot;;margin-top:0;orphans:2;margin-bottom:0;widows:2;text-align:left;padding-right:0"><span style="color:#1b1c1d;font-weight:700;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal">Integration Tests (The Middle Layer):</span></li></ul><ul class="lst-kix_iw3301jms20c-1 start" style="padding:0;margin:0"><li style="padding-top:0pt;color:#000000;padding-left:0pt;font-size:11pt;padding-bottom:30pt;line-height:1.15;margin-right:0;margin-left:72pt;font-family:&quot;Arial&quot;;margin-top:0;orphans:2;margin-bottom:0;widows:2;text-align:left;padding-right:0"><span style="color:#1b1c1d;font-weight:700">What:</span><span style="color:#1b1c1d;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal">&nbsp;Tests how multiple units work together. For example, does your web application's route function correctly call the database module?</span></li><li style="padding-top:0pt;color:#000000;padding-left:0pt;font-size:11pt;padding-bottom:30pt;line-height:1.15;margin-right:0;margin-left:72pt;font-family:&quot;Arial&quot;;margin-top:0;orphans:2;margin-bottom:0;widows:2;text-align:left;padding-right:0"><span style="color:#1b1c1d;font-weight:700">Goal:</span><span style="color:#1b1c1d;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal">&nbsp;To find errors in the interactions between different parts of your system.</span></li><li style="padding-top:0pt;color:#000000;padding-left:0pt;font-size:11pt;padding-bottom:30pt;line-height:1.15;margin-right:0;margin-left:72pt;font-family:&quot;Arial&quot;;margin-top:0;orphans:2;margin-bottom:0;widows:2;text-align:left;padding-right:0"><span style="color:#1b1c1d;font-weight:700">Characteristics:</span><span style="color:#1b1c1d;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal">&nbsp;Slower than unit tests, more complex to set up.</span></li></ul><ul class="lst-kix_iw3301jms20c-0" style="padding:0;margin:0"><li style="padding-top:0pt;color:#000000;padding-left:0pt;font-size:11pt;padding-bottom:18pt;line-height:1.15;margin-right:0;margin-left:36pt;font-family:&quot;Arial&quot;;margin-top:0;orphans:2;margin-bottom:0;widows:2;text-align:left;padding-right:0"><span style="color:#1b1c1d;font-weight:700;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal">End-to-End (E2E) Tests (The Peak):</span></li></ul><ul class="lst-kix_iw3301jms20c-1 start" style="padding:0;margin:0"><li style="padding-top:0pt;color:#000000;padding-left:0pt;font-size:11pt;padding-bottom:30pt;line-height:1.15;margin-right:0;margin-left:72pt;font-family:&quot;Arial&quot;;margin-top:0;orphans:2;margin-bottom:0;widows:2;text-align:left;padding-right:0"><span style="color:#1b1c1d;font-weight:700">What:</span><span style="color:#1b1c1d;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal">&nbsp;Simulates a real user's journey through the entire application. It tests the complete, integrated system. For a web app, this might involve using a tool to automatically open a browser, click buttons, and verify the content on the page.</span></li><li style="padding-top:0pt;color:#000000;padding-left:0pt;font-size:11pt;padding-bottom:30pt;line-height:1.15;margin-right:0;margin-left:72pt;font-family:&quot;Arial&quot;;margin-top:0;orphans:2;margin-bottom:0;widows:2;text-align:left;padding-right:0"><span style="color:#1b1c1d;font-weight:700">Goal:</span><span style="color:#1b1c1d;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal">&nbsp;To ensure the entire application works as expected from the user's perspective.</span></li><li style="padding-top:0pt;color:#000000;padding-left:0pt;font-size:11pt;padding-bottom:30pt;line-height:1.15;margin-right:0;margin-left:72pt;font-family:&quot;Arial&quot;;margin-top:0;orphans:2;margin-bottom:0;widows:2;text-align:left;padding-right:0"><span style="color:#1b1c1d;font-weight:700">Characteristics:</span><span style="color:#1b1c1d;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal">&nbsp;Very slow, expensive to write and maintain, and can be brittle (they break easily if the UI changes). You should have very few of these.</span></li></ul><p style="padding-top:0pt;margin:0;color:#000000;padding-left:0;font-size:11pt;padding-bottom:12pt;font-family:&quot;Arial&quot;;line-height:1.15;orphans:2;widows:2;text-align:left;padding-right:0"><span style="color:#1b1c1d">This course will focus primarily on </span><span style="color:#1b1c1d;font-weight:700">unit testing</span><span style="color:#1b1c1d;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal">, as it provides the most value for the effort involved.</span></p><hr><p style="padding:0;margin:0;color:#000000;font-size:11pt;font-family:&quot;Arial&quot;;line-height:1.15;orphans:2;widows:2;height:11pt;text-align:left"><span style="color:#1b1c1d;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal"></span></p><h3 id="h.7fdi5erep7mj" style="padding-top:0pt;margin:0;color:#434343;padding-left:0;font-size:14pt;padding-bottom:6pt;line-height:1.15;page-break-after:avoid;font-family:&quot;Arial&quot;;orphans:2;widows:2;text-align:left;padding-right:0"><span style="color:#1b1c1d;font-weight:700;text-decoration:none;vertical-align:baseline;font-size:13pt;font-family:&quot;Arial&quot;;font-style:normal">Further Research</span></h3><ul class="lst-kix_x5xduk7imbwn-0 start" style="padding:0;margin:0"><li style="padding-top:0pt;color:#000000;padding-left:0pt;font-size:11pt;padding-bottom:18pt;line-height:1.15;margin-right:0;margin-left:36pt;font-family:&quot;Arial&quot;;margin-top:0;orphans:2;margin-bottom:0;widows:2;text-align:left;padding-right:0"><span style="color:#1b1c1d;font-weight:700">The Practical Test Pyramid (Martin Fowler):</span><span style="color:#1b1c1d"><a href="https://www.google.com/url?q=https://martinfowler.com/articles/practical-test-pyramid.html&amp;sa=D&amp;source=editors&amp;ust=1786364336279567&amp;usg=AOvVaw05mnSHLShzVN-SZJ-t2Ran" style="color:inherit;text-decoration:inherit">&nbsp;</a></span><span style="text-decoration-skip-ink:none;-webkit-text-decoration-skip:none;color:#0b57d0;text-decoration:underline"><a href="https://www.google.com/url?q=https://martinfowler.com/articles/practical-test-pyramid.html&amp;sa=D&amp;source=editors&amp;ust=1786364336279686&amp;usg=AOvVaw1WfTS_GnaSlHy0j9t6V0So" style="color:inherit;text-decoration:inherit">https://martinfowler.com/articles/practical-test-pyramid.html</a></span></li><li style="padding-top:0pt;color:#000000;padding-left:0pt;font-size:11pt;padding-bottom:18pt;line-height:1.15;margin-right:0;margin-left:36pt;font-family:&quot;Arial&quot;;margin-top:0;orphans:2;margin-bottom:0;widows:2;text-align:left;padding-right:0"><span style="color:#1b1c1d;font-weight:700">Getting Started with Testing in Python (Real Python):</span><span style="color:#1b1c1d"><a href="https://www.google.com/url?q=https://realpython.com/python-testing/&amp;sa=D&amp;source=editors&amp;ust=1786364336279816&amp;usg=AOvVaw3-dM6egFqLsc_Dg18sekxg" style="color:inherit;text-decoration:inherit">&nbsp;</a></span><span style="text-decoration-skip-ink:none;-webkit-text-decoration-skip:none;color:#0b57d0;text-decoration:underline"><a href="https://www.google.com/url?q=https://realpython.com/python-testing/&amp;sa=D&amp;source=editors&amp;ust=1786364336279889&amp;usg=AOvVaw2wbKvnF851hcQOjMRkiOwy" style="color:inherit;text-decoration:inherit">https://realpython.com/python-testing/</a></span></li></ul><hr><p style="padding:0;margin:0;color:#000000;font-size:11pt;font-family:&quot;Arial&quot;;line-height:1.15;orphans:2;widows:2;height:11pt;text-align:left"><span style="color:#1b1c1d;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal"></span></p><h2 id="h.8ok5i762543b" style="padding-top:0pt;margin:0;color:#000000;padding-left:0;font-size:16pt;padding-bottom:6pt;line-height:1.15;page-break-after:avoid;font-family:&quot;Arial&quot;;orphans:2;widows:2;text-align:left;padding-right:0"><span style="color:#1b1c1d;font-size:17pt;font-weight:700">Week 2: Unit Testing with </span><span style="background-color:#e9eef6;color:#575b5f;font-weight:700;text-decoration:none;vertical-align:baseline;font-size:17pt;font-family:&quot;Arial&quot;;font-style:normal">pytest</span></h2><p style="padding-top:0pt;margin:0;color:#000000;padding-left:0;font-size:11pt;padding-bottom:12pt;font-family:&quot;Arial&quot;;line-height:1.15;orphans:2;widows:2;text-align:left;padding-right:0"><span style="color:#1b1c1d">This week, you'll learn the practical skills of writing unit tests using </span><span style="background-color:#e9eef6;color:#575b5f;font-weight:700">pytest</span><span style="color:#1b1c1d;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal">, the most popular and user-friendly testing framework in the Python ecosystem.</span></p><h3 id="h.a848oayxc1zx" style="padding-top:0pt;margin:0;color:#434343;padding-left:0;font-size:14pt;padding-bottom:6pt;line-height:1.15;page-break-after:avoid;font-family:&quot;Arial&quot;;orphans:2;widows:2;text-align:left;padding-right:0"><span style="color:#1b1c1d;font-size:13pt;font-weight:700">Why </span><span style="background-color:#e9eef6;font-size:13pt;color:#575b5f;font-weight:700">pytest</span><span style="color:#1b1c1d;font-weight:700;text-decoration:none;vertical-align:baseline;font-size:13pt;font-family:&quot;Arial&quot;;font-style:normal">?</span></h3><p style="padding-top:0pt;margin:0;color:#000000;padding-left:0;font-size:11pt;padding-bottom:12pt;font-family:&quot;Arial&quot;;line-height:1.15;orphans:2;widows:2;text-align:left;padding-right:0"><span style="color:#1b1c1d">While Python has a built-in </span><span style="background-color:#e9eef6;color:#575b5f">unittest</span><span style="color:#1b1c1d">&nbsp;module, </span><span style="background-color:#e9eef6;color:#575b5f">pytest</span><span style="color:#1b1c1d">&nbsp;is preferred by most developers because it requires less boilerplate code, has a simpler </span><span style="background-color:#e9eef6;color:#575b5f">assert</span><span style="color:#1b1c1d;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal">&nbsp;statement, and has a rich ecosystem of plugins.</span></p><h3 id="h.d7akij35prn5" style="padding-top:0pt;margin:0;color:#434343;padding-left:0;font-size:14pt;padding-bottom:6pt;line-height:1.15;page-break-after:avoid;font-family:&quot;Arial&quot;;orphans:2;widows:2;text-align:left;padding-right:0"><span style="color:#1b1c1d;font-size:13pt;font-weight:700">Getting Started with </span><span style="background-color:#e9eef6;color:#575b5f;font-weight:700;text-decoration:none;vertical-align:baseline;font-size:13pt;font-family:&quot;Arial&quot;;font-style:normal">pytest</span></h3><p style="padding-top:0pt;margin:0;color:#000000;padding-left:0;font-size:11pt;padding-bottom:12pt;font-family:&quot;Arial&quot;;line-height:1.15;orphans:2;widows:2;text-align:left;padding-right:0"><span style="color:#1b1c1d;font-weight:700;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal">1. Installation:</span></p><p style="padding-top:0pt;margin:0;color:#000000;padding-left:0;font-size:11pt;padding-bottom:14pt;line-height:1.15;background-color:#f0f4f9;font-family:&quot;Arial&quot;;orphans:2;widows:2;text-align:left;padding-right:0"><span style="color:#575b5f;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal">Bash</span></p><p style="padding:0;margin:0;color:#000000;font-size:11pt;font-family:&quot;Arial&quot;;line-height:1.15;orphans:2;widows:2;text-align:left"><span style="color:#575b5f;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:10.5pt;font-family:&quot;Arial&quot;;font-style:normal">pip install pytest</span></p><p style="padding-top:0pt;margin:0;color:#000000;padding-left:0;font-size:11pt;padding-bottom:12pt;line-height:1.15;background-color:#f0f4f9;font-family:&quot;Arial&quot;;orphans:2;widows:2;height:11pt;text-align:left;padding-right:0"><span style="color:#575b5f;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:10.5pt;font-family:&quot;Arial&quot;;font-style:normal"></span></p><p style="padding-top:0pt;margin:0;color:#000000;padding-left:0;font-size:11pt;padding-bottom:12pt;font-family:&quot;Arial&quot;;line-height:1.15;orphans:2;widows:2;text-align:left;padding-right:0"><span style="color:#1b1c1d;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal">2. Naming Conventions:</span></p><p style="padding-top:0pt;margin:0;color:#000000;padding-left:0;font-size:11pt;padding-bottom:12pt;font-family:&quot;Arial&quot;;line-height:1.15;orphans:2;widows:2;text-align:left;padding-right:0"><span style="color:#1b1c1d;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal">pytest automatically discovers and runs your tests if you follow these naming conventions:</span></p><ul class="lst-kix_3p4511cwql7o-0 start" style="padding:0;margin:0"><li style="padding-top:0pt;color:#000000;padding-left:0pt;font-size:11pt;padding-bottom:18pt;line-height:1.15;margin-right:0;margin-left:36pt;font-family:&quot;Arial&quot;;margin-top:0;orphans:2;margin-bottom:0;widows:2;text-align:left;padding-right:0"><span style="color:#1b1c1d">Test files must be named </span><span style="background-color:#e9eef6;color:#575b5f">test_*.py</span><span style="color:#1b1c1d">&nbsp;or </span><span style="background-color:#e9eef6;color:#575b5f">*_test.py</span><span style="color:#1b1c1d;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal">.</span></li><li style="padding-top:0pt;color:#000000;padding-left:0pt;font-size:11pt;padding-bottom:18pt;line-height:1.15;margin-right:0;margin-left:36pt;font-family:&quot;Arial&quot;;margin-top:0;orphans:2;margin-bottom:0;widows:2;text-align:left;padding-right:0"><span style="color:#1b1c1d">Test functions inside those files must be named </span><span style="background-color:#e9eef6;color:#575b5f">test_*()</span><span style="color:#1b1c1d;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal">.</span></li></ul><p style="padding-top:0pt;margin:0;color:#000000;padding-left:0;font-size:11pt;padding-bottom:12pt;font-family:&quot;Arial&quot;;line-height:1.15;orphans:2;widows:2;text-align:left;padding-right:0"><span style="color:#1b1c1d;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal">3. Writing Your First Test:</span></p><p style="padding-top:0pt;margin:0;color:#000000;padding-left:0;font-size:11pt;padding-bottom:12pt;font-family:&quot;Arial&quot;;line-height:1.15;orphans:2;widows:2;text-align:left;padding-right:0"><span style="color:#1b1c1d;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal">Let's say we have a simple function to test in a file named calculator.py:</span></p><p style="padding-top:0pt;margin:0;color:#000000;padding-left:0;font-size:11pt;padding-bottom:14pt;line-height:1.15;background-color:#f0f4f9;font-family:&quot;Arial&quot;;orphans:2;widows:2;text-align:left;padding-right:0"><span style="color:#575b5f;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal">Python</span></p><p style="padding:0;margin:0;color:#000000;font-size:11pt;font-family:&quot;Arial&quot;;line-height:1.15;orphans:2;widows:2;text-align:left"><span style="color:#5f6368;font-size:10.5pt"># calculator.py</span></p><p style="padding:0;margin:0;color:#000000;font-size:11pt;font-family:&quot;Arial&quot;;line-height:1.15;orphans:2;widows:2;text-align:left"><span style="color:#8430ce;font-size:10.5pt">def</span><span style="color:#575b5f;font-size:10.5pt">&nbsp;</span><span style="color:#996900;font-size:10.5pt">add</span><span style="color:#575b5f;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:10.5pt;font-family:&quot;Arial&quot;;font-style:normal">(a, b):</span></p><p style="padding:0;margin:0;color:#000000;font-size:11pt;font-family:&quot;Arial&quot;;line-height:1.15;orphans:2;widows:2;text-align:left"><span style="color:#575b5f;font-size:10.5pt">&nbsp; &nbsp; </span><span style="color:#8430ce;font-size:10.5pt">return</span><span style="color:#575b5f;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:10.5pt;font-family:&quot;Arial&quot;;font-style:normal">&nbsp;a + b</span></p><p style="padding-top:0pt;margin:0;color:#000000;padding-left:0;font-size:11pt;padding-bottom:12pt;line-height:1.15;background-color:#f0f4f9;font-family:&quot;Arial&quot;;orphans:2;widows:2;height:11pt;text-align:left;padding-right:0"><span style="color:#575b5f;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:10.5pt;font-family:&quot;Arial&quot;;font-style:normal"></span></p><p style="padding-top:0pt;margin:0;color:#000000;padding-left:0;font-size:11pt;padding-bottom:12pt;font-family:&quot;Arial&quot;;line-height:1.15;orphans:2;widows:2;text-align:left;padding-right:0"><span style="color:#1b1c1d">Now, we create our test file, </span><span style="background-color:#e9eef6;color:#575b5f">test_calculator.py</span><span style="color:#1b1c1d;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal">, in the same folder:</span></p><p style="padding-top:0pt;margin:0;color:#000000;padding-left:0;font-size:11pt;padding-bottom:14pt;line-height:1.15;background-color:#f0f4f9;font-family:&quot;Arial&quot;;orphans:2;widows:2;text-align:left;padding-right:0"><span style="color:#575b5f;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal">Python</span></p><p style="padding:0;margin:0;color:#000000;font-size:11pt;font-family:&quot;Arial&quot;;line-height:1.15;orphans:2;widows:2;text-align:left"><span style="color:#5f6368;font-size:10.5pt"># test_calculator.py</span></p><p