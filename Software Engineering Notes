color:#575b5f;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:10.5pt;font-family:&quot;Arial&quot;;font-style:normal"></span></p><p style="padding:0;margin:0;color:#000000;font-size:11pt;font-family:&quot;Arial&quot;;line-height:1.15;orphans:2;widows:2;text-align:left"><span style="color:#575b5f;font-size:10.5pt">&nbsp; &nbsp; </span><span style="color:#5f6368;font-size:10.5pt"># This is called when you do len(my_book)</span></p><p style="padding:0;margin:0;color:#000000;font-size:11pt;font-family:&quot;Arial&quot;;line-height:1.15;orphans:2;widows:2;text-align:left"><span style="color:#575b5f;font-size:10.5pt">&nbsp; &nbsp; </span><span style="color:#8430ce;font-size:10.5pt">def</span><span style="color:#575b5f;font-size:10.5pt">&nbsp;</span><span style="color:#996900;font-size:10.5pt">__len__</span><span style="color:#575b5f;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:10.5pt;font-family:&quot;Arial&quot;;font-style:normal">(self):</span></p><p style="padding:0;margin:0;color:#000000;font-size:11pt;font-family:&quot;Arial&quot;;line-height:1.15;orphans:2;widows:2;text-align:left"><span style="color:#575b5f;font-size:10.5pt">&nbsp; &nbsp; &nbsp; &nbsp; </span><span style="color:#8430ce;font-size:10.5pt">return</span><span style="color:#575b5f;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:10.5pt;font-family:&quot;Arial&quot;;font-style:normal">&nbsp;self.pages</span></p><p style="padding:0;margin:0;color:#000000;font-size:11pt;font-family:&quot;Arial&quot;;line-height:1.15;orphans:2;widows:2;height:11pt;text-align:left"><span style="color:#575b5f;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:10.5pt;font-family:&quot;Arial&quot;;font-style:normal"></span></p><p style="padding:0;margin:0;color:#000000;font-size:11pt;font-family:&quot;Arial&quot;;line-height:1.15;orphans:2;widows:2;text-align:left"><span style="color:#575b5f;font-size:10.5pt">my_book = Book(</span><span style="color:#188038;font-size:10.5pt">"The Hobbit"</span><span style="color:#575b5f;font-size:10.5pt">, </span><span style="color:#188038;font-size:10.5pt">"J.R.R. Tolkien"</span><span style="color:#575b5f;font-size:10.5pt">, </span><span style="color:#b55908;font-size:10.5pt">310</span><span style="color:#575b5f;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:10.5pt;font-family:&quot;Arial&quot;;font-style:normal">)</span></p><p style="padding:0;margin:0;color:#000000;font-size:11pt;font-family:&quot;Arial&quot;;line-height:1.15;orphans:2;widows:2;height:11pt;text-align:left"><span style="color:#575b5f;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:10.5pt;font-family:&quot;Arial&quot;;font-style:normal"></span></p><p style="padding:0;margin:0;color:#000000;font-size:11pt;font-family:&quot;Arial&quot;;line-height:1.15;orphans:2;widows:2;text-align:left"><span style="color:#5f6368;font-size:10.5pt"># The __str__ method is called automatically by print()</span></p><p style="padding:0;margin:0;color:#000000;font-size:11pt;font-family:&quot;Arial&quot;;line-height:1.15;orphans:2;widows:2;text-align:left"><span style="color:#575b5f;font-size:10.5pt">print(my_book) &nbsp;</span><span style="color:#5f6368;font-size:10.5pt"># Output: 'The Hobbit' by J.R.R. Tolkien</span></p><p style="padding:0;margin:0;color:#000000;font-size:11pt;font-family:&quot;Arial&quot;;line-height:1.15;orphans:2;widows:2;height:11pt;text-align:left"><span style="color:#575b5f;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:10.5pt;font-family:&quot;Arial&quot;;font-style:normal"></span></p><p style="padding:0;margin:0;color:#000000;font-size:11pt;font-family:&quot;Arial&quot;;line-height:1.15;orphans:2;widows:2;text-align:left"><span style="color:#5f6368;font-size:10.5pt"># The __len__ method is called automatically by len()</span></p><p style="padding:0;margin:0;color:#000000;font-size:11pt;font-family:&quot;Arial&quot;;line-height:1.15;orphans:2;widows:2;text-align:left"><span style="color:#575b5f;font-size:10.5pt">print(</span><span style="color:#188038;font-size:10.5pt">f"The book has </span><span style="color:#1b1c1d;font-size:10.5pt">{</span><span style="color:#1967d2;font-size:10.5pt">len</span><span style="color:#1b1c1d;font-size:10.5pt">(my_book)}</span><span style="color:#188038;font-size:10.5pt">&nbsp;pages."</span><span style="color:#575b5f;font-size:10.5pt">) </span><span style="color:#5f6368;font-size:10.5pt"># Output: The book has 310 pages.</span></p><p style="padding-top:0pt;margin:0;color:#000000;padding-left:0;font-size:11pt;padding-bottom:12pt;line-height:1.15;background-color:#f0f4f9;font-family:&quot;Arial&quot;;orphans:2;widows:2;height:11pt;text-align:left;padding-right:0"><span style="color:#575b5f;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:10.5pt;font-family:&quot;Arial&quot;;font-style:normal"></span></p><p style="padding-top:0pt;margin:0;color:#000000;padding-left:0;font-size:11pt;padding-bottom:12pt;font-family:&quot;Arial&quot;;line-height:1.15;orphans:2;widows:2;text-align:left;padding-right:0"><span style="color:#1b1c1d;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal">By implementing these dunder methods, you make your custom objects behave more intuitively, just like Python's built-in objects.</span></p><hr><p style="padding:0;margin:0;color:#000000;font-size:11pt;font-family:&quot;Arial&quot;;line-height:1.15;orphans:2;widows:2;height:11pt;text-align:left"><span style="color:#1b1c1d;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal"></span></p><h3 id="h.7y76g1kee0po" style="padding-top:0pt;margin:0;color:#434343;padding-left:0;font-size:14pt;padding-bottom:6pt;line-height:1.15;page-break-after:avoid;font-family:&quot;Arial&quot;;orphans:2;widows:2;text-align:left;padding-right:0"><span style="color:#1b1c1d;font-weight:700;text-decoration:none;vertical-align:baseline;font-size:13pt;font-family:&quot;Arial&quot;;font-style:normal">Further Research</span></h3><ul class="lst-kix_d3or42jdi1bs-0 start" style="padding:0;margin:0"><li style="padding-top:0pt;color:#000000;padding-left:0pt;font-size:11pt;padding-bottom:18pt;line-height:1.15;margin-right:0;margin-left:36pt;font-family:&quot;Arial&quot;;margin-top:0;orphans:2;margin-bottom:0;widows:2;text-align:left;padding-right:0"><span style="color:#1b1c1d;font-weight:700">A Guide to Python's Magic Methods (Real Python):</span><span style="color:#1b1c1d"><a href="https://www.google.com/url?q=https://realpython.com/python-magic-methods/&amp;sa=D&amp;source=editors&amp;ust=1786364336191871&amp;usg=AOvVaw22fSI6eC9_vOCgGFHi_eX4" style="color:inherit;text-decoration:inherit">&nbsp;</a></span><span style="text-decoration-skip-ink:none;-webkit-text-decoration-skip:none;color:#0b57d0;text-decoration:underline"><a href="https://www.google.com/url?q=https://realpython.com/python-magic-methods/&amp;sa=D&amp;source=editors&amp;ust=1786364336191969&amp;usg=AOvVaw2v-vhmtbQ-ctsVNlRvVXt8" style="color:inherit;text-decoration:inherit">https://realpython.com/python-magic-methods/</a></span></li><li style="padding-top:0pt;color:#000000;padding-left:0pt;font-size:11pt;padding-bottom:18pt;line-height:1.15;margin-right:0;margin-left:36pt;font-family:&quot;Arial&quot;;margin-top:0;orphans:2;margin-bottom:0;widows:2;text-align:left;padding-right:0"><span style="color:#1b1c1d;font-weight:700">Data Model (Official Python Docs):</span><span style="color:#1b1c1d"><a href="https://www.google.com/url?q=https://docs.python.org/3/reference/datamodel.html&amp;sa=D&amp;source=editors&amp;ust=1786364336192113&amp;usg=AOvVaw2wfMINz4q0fsbVazY6hNaj" style="color:inherit;text-decoration:inherit">&nbsp;</a></span><span style="text-decoration-skip-ink:none;-webkit-text-decoration-skip:none;color:#0b57d0;text-decoration:underline"><a href="https://www.google.com/url?q=https://docs.python.org/3/reference/datamodel.html&amp;sa=D&amp;source=editors&amp;ust=1786364336192202&amp;usg=AOvVaw32Iqhf4GGLZgLA97r91r9z" style="color:inherit;text-decoration:inherit">https://docs.python.org/3/reference/datamodel.html</a></span><span style="color:#1b1c1d;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal">&nbsp;(This is the exhaustive list of all dunder methods.)</span></li></ul><p style="padding:0;margin:0;color:#000000;font-size:11pt;font-family:&quot;Arial&quot;;line-height:1.15;orphans:2;widows:2;height:11pt;text-align:left"><span style="color:#000000;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal"></span></p><p class="title" id="h.irvj3u98t9p7" style="padding:0;margin:0;color:#000000;font-size:26pt;font-family:&quot;Arial&quot;;line-height:1.15;page-break-after:avoid;orphans:2;widows:2;text-align:left"><span style="color:#000000;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:26pt;font-family:&quot;Arial&quot;;font-style:normal">Module 5: version Control</span></p><h3 id="h.jhibhg6n2npb" style="padding-top:0pt;margin:0;color:#434343;padding-left:0;font-size:14pt;padding-bottom:6pt;line-height:1.15;page-break-after:avoid;font-family:&quot;Arial&quot;;orphans:2;widows:2;text-align:left;padding-right:0"><span style="color:#1b1c1d;font-size:13pt;font-weight:700">Module 5: Version Control with Git and GitHub</span></h3><h2 id="h.f0d04t6gkkhs" style="padding-top:0pt;margin:0;color:#000000;padding-left:0;font-size:16pt;padding-bottom:6pt;line-height:1.15;page-break-after:avoid;font-family:&quot;Arial&quot;;orphans:2;widows:2;text-align:left;padding-right:0"><span style="color:#1b1c1d;font-weight:700;text-decoration:none;vertical-align:baseline;font-size:17pt;font-family:&quot;Arial&quot;;font-style:normal">Week 1: Plain Text Files and Context Managers</span></h2><p style="padding-top:0pt;margin:0;color:#000000;padding-left:0;font-size:11pt;padding-bottom:12pt;font-family:&quot;Arial&quot;;line-height:1.15;orphans:2;widows:2;text-align:left;padding-right:0"><span style="color:#1b1c1d">This week, you'll learn the fundamentals of interacting with files on your computer. Your programs so far have lost all their data when they stop running. </span><span style="color:#1b1c1d;font-weight:700">Data persistence</span><span style="color:#1b1c1d">&nbsp;is the concept of saving data so it exists even after your program closes. The simplest way to do this is with plain text (</span><span style="background-color:#e9eef6;color:#575b5f">.txt</span><span style="color:#1b1c1d;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal">) files.</span></p><h3 id="h.rujhvgcuoshj" style="padding-top:0pt;margin:0;color:#434343;padding-left:0;font-size:14pt;padding-bottom:6pt;line-height:1.15;page-break-after:avoid;font-family:&quot;Arial&quot;;orphans:2;widows:2;text-align:left;padding-right:0"><span style="color:#1b1c1d;font-weight:700;text-decoration:none;vertical-align:baseline;font-size:13pt;font-family:&quot;Arial&quot;;font-style:normal">Reading from and Writing to Files</span></h3><ul class="lst-kix_gsdjfh6s6l3p-0 start" style="padding:0;margin:0"><li style="padding-top:0pt;color:#000000;padding-left:0pt;font-size:11pt;padding-bottom:18pt;line-height:1.15;margin-right:0;margin-left:36pt;font-family:&quot;Arial&quot;;margin-top:0;orphans:2;margin-bottom:0;widows:2;text-align:left;padding-right:0"><span style="color:#1b1c1d;font-weight:700">Analogy:</span><span style="color:#1b1c1d">&nbsp;Working with a file is like working with a physical notebook üìì. First, you have to </span><span style="color:#1b1c1d;font-weight:700">open</span><span style="color:#1b1c1d">&nbsp;it. Then you can </span><span style="color:#1b1c1d;font-weight:700">read</span><span style="color:#1b1c1d">&nbsp;what's inside or </span><span style="color:#1b1c1d;font-weight:700">write</span><span style="color:#1b1c1d">&nbsp;something new. When you're done, it's crucial that you </span><span style="color:#1b1c1d;font-weight:700">close</span><span style="color:#1b1c1d;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal">&nbsp;it to make sure everything is saved properly.</span></li></ul><h3 id="h.p33gxup7hdw9" style="padding-top:0pt;margin:0;color:#434343;padding-left:0;font-size:14pt;padding-bottom:6pt;line-height:1.15;page-break-after:avoid;font-family:&quot;Arial&quot;;orphans:2;widows:2;text-align:left;padding-right:0"><span style="color:#1b1c1d;font-size:13pt;font-weight:700">The </span><span style="background-color:#e9eef6;font-size:13pt;color:#575b5f;font-weight:700">open()</span><span style="color:#1b1c1d;font-weight:700;text-decoration:none;vertical-align:baseline;font-size:13pt;font-family:&quot;Arial&quot;;font-style:normal">&nbsp;Function and File Modes</span></h3><p style="padding-top:0pt;margin:0;color:#000000;padding-left:0;font-size:11pt;padding-bottom:6pt;font-family:&quot;Arial&quot;;line-height:1.15;orphans:2;widows:2;text-align:left;padding-right:0"><span style="color:#1b1c1d">The built-in </span><span style="background-color:#e9eef6;color:#575b5f">open()</span><span style="color:#1b1c1d">&nbsp;function is your gateway to files. It takes two main arguments: the file path and the </span><span style="color:#1b1c1d;font-weight:700">mode</span><span style="color:#1b1c1d;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal">. The mode tells Python what you want to do with the file.</span></p><ul class="lst-kix_piabm0yazwlx-0 start" style="padding:0;margin:0"><li style="padding-top:0pt;color:#000000;padding-left:0pt;font-size:11pt;padding-bottom:18pt;line-height:1.15;margin-right:0;margin-left:36pt;font-family:&quot;Arial&quot;;margin-top:0;orphans:2;margin-bottom:0;widows:2;text-align:left;padding-right:0"><span style="background-color:#e9eef6;color:#575b5f">'r'</span><span style="color:#1b1c1d">&nbsp;- </span><span style="color:#1b1c1d;font-weight:700">Read mode:</span><span style="color:#1b1c1d;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal">&nbsp;The default mode. Opens a file for reading. Gives an error if the file doesn't exist.</span></li><li style="padding-top:0pt;color:#000000;padding-left:0pt;font-size:11pt;padding-bottom:18pt;line-height:1.15;margin-right:0;margin-left:36pt;font-family:&quot;Arial&quot;;margin-top:0;orphans:2;margin-bottom:0;widows:2;text-align:left;padding-right:0"><span style="background-color:#e9eef6;color:#575b5f">'w'</span><span style="color:#1b1c1d">&nbsp;- </span><span style="color:#1b1c1d;font-weight:700">Write mode:</span><span style="color:#1b1c1d">&nbsp;Opens a file for writing. </span><span style="color:#1b1c1d;font-weight:700;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal">It will create the file if it doesn't exist, but it will erase the entire contents of the file if it does exist.</span></li><li style="padding-top:0pt;color:#000000;padding-left:0pt;font-size:11pt;padding-bottom:18pt;line-height:1.15;margin-right:0;margin-left:36pt;font-family:&quot;Arial&quot;;margin-top:0;orphans:2;margin-bottom:0;widows:2;text-align:left;padding-right:0"><span style="background-color:#e9eef6;color:#575b5f">'a'</span><span style="color:#1b1c1d">&nbsp;- </span><span style="color:#1b1c1d;font-weight:700">Append mode:</span><span style="color:#1b1c1d">&nbsp;Opens a file for appending. It will create the file if it doesn't exist. New data is written to the </span><span style="color:#1b1c1d;font-weight:700">end</span><span style="color:#1b1c1d;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal">&nbsp;of the file, without erasing what's already there.</span></li></ul><h3 id="h.9med35v3jrgp" style="padding-top:0pt;margin:0;color:#434343;padding-left:0;font-size:14pt;padding-bottom:6pt;line-height:1.15;page-break-after:avoid;font-family:&quot;Arial&quot;;orphans:2;widows:2;text-align:left;padding-right:0"><span style="color:#1b1c1d;font-weight:700;text-decoration:none;vertical-align:baseline;font-size:13pt;font-family:&quot;Arial&quot;;font-style:normal">The Problem: Forgetting to Close</span></h3><p style="padding-top:0pt;margin:0;color:#000000;padding-left:0;font-size:11pt;padding-bottom:12pt;font-family:&quot;Arial&quot;;line-height:1.15;orphans:2;widows:2;text-align:left;padding-right:0"><span style="color:#1b1c1d">Forgetting to </span><span style="background-color:#e9eef6;color:#575b5f">file.close()</span><span style="color:#1b1c1d;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal">&nbsp;can lead to data corruption or files being locked by your program. It's a common source of bugs.</span></p><p style="padding-top:0pt;margin:0;color:#000000;padding-left:0;font-size:11pt;padding-bottom:14pt;line-height:1.15;background-color:#f0f4f9;font-family:&quot;Arial&quot;;orphans:2;widows:2;text-align:left;padding-right:0"><span style="color:#575b5f;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal">Python</span></p><p style="padding:0;margin:0;color:#000000;font-size:11pt;font-family:&quot;Arial&quot;;line-height:1.15;orphans:2;widows:2;text-align:left"><span style="color:#5f6368;font-size:10.5pt"># The "old" way - not recommended</span></p><p style="padding:0;margin:0;color:#000000;font-size:11pt;font-family:&quot;Arial&quot;;line-height:1.15;orphans:2;widows:2;text-align:left"><span style="color:#575b5f;font-size:10.5pt">file = </span><span style="color:#1967d2;font-size:10.5pt">open</span><span style="color:#575b5f;font-size:10.5pt">(</span><span style="color:#188038;font-size:10.5pt">"my_notes.txt"</span><span style="color:#575b5f;font-size:10.5pt">, </span><span style="color:#188038;font-size:10.5pt">"w"</span><span style="color:#575b5f;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:10.5pt;font-family:&quot;Arial&quot;;font-style:normal">)</span></p><p style="padding:0;margin:0;color:#000000;font-size:11pt;font-family:&quot;Arial&quot;;line-height:1.15;orphans:2;widows:2;text-align:left"><span style="color:#575b5f;font-size:10.5pt">file.write(</span><span style="color:#188038;font-size:10.5pt">"This is my first note."</span><span style="color:#575b5f;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:10.5pt;font-family:&quot;Arial&quot;;font-style:normal">)</span></p><p style="padding:0;margin:0;color:#000000;font-size:11pt;font-family:&quot;Arial&quot;;line-height:1.15;orphans:2;widows:2;text-align:left"><span style="color:#575b5f;font-size:10.5pt">file.close() </span><span style="color:#5f6368;font-size:10.5pt"># You have to remember this!</span></p><p style="padding-top:0pt;margin:0;color:#000000;padding-left:0;font-size:11pt;padding-bottom:12pt;line-height:1.15;background-color:#f0f4f9;font-family:&quot;Arial&quot;;orphans:2;widows:2;height:11pt;text-align:left;padding-right:0"><span style="color:#575b5f;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:10.5pt;font-family:&quot;Arial&quot;;font-style:normal"></span></p><h3 id="h.3isglmdj5qsm" style="padding-top:0pt;margin:0;color:#434343;padding-left:0;font-size:14pt;padding-bottom:6pt;line-height:1.15;page-break-after:avoid;font-family:&quot;Arial&quot;;orphans:2;widows:2;text-align:left;padding-right:0"><span style="color:#1b1c1d;font-size:13pt;font-weight:700">The Solution: Context Managers (</span><span style="background-color:#e9eef6;font-size:13pt;color:#575b5f;font-weight:700">with</span><span style="color:#1b1c1d;font-weight:700;text-decoration:none;vertical-align:baseline;font-size:13pt;font-family:&quot;Arial&quot;;font-style:normal">&nbsp;statement)</span></h3><p style="padding-top:0pt;margin:0;color:#000000;padding-left:0;font-size:11pt;padding-bottom:12pt;font-family:&quot;Arial&quot;;line-height:1.15;orphans:2;widows:2;text-align:left;padding-right:0"><span style="color:#1b1c1d">Python has a modern, safer way to handle files using the </span><span style="background-color:#e9eef6;color:#575b5f">with</span><span style="color:#1b1c1d">&nbsp;statement. This creates a </span><span style="color:#1b1c1d;font-weight:700">context manager</span><span style="color:#1b1c1d;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal">, which automatically handles the setup and teardown (i.e., it automatically closes the file for you, even if errors occur).</span></p><p style="padding-top:0pt;margin:0;color:#000000;padding-left:0;font-size:11pt;padding-bottom:12pt;font-family:&quot;Arial&quot;;line-height:1.15;orphans:2;widows:2;text-align:left;padding-right:0"><span style="color:#1b1c1d;font-weight:700;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal">This is the standard, preferred way to work with files in Python.</span></p><p style="padding-top:0pt;margin:0;color:#000000;padding-left:0;font-size:11pt;padding-bottom:14pt;line-height:1.15;background-color:#f0f4f9;font-family:&quot;Arial&quot;;orphans:2;widows:2;text-align:left;padding-right:0"><span style="color:#575b5f;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal">Python</span></p><p style="padding:0;margin:0;color:#000000;font-size:11pt;font-family:&quot;Arial&quot;;line-height:1.15;orphans:2;widows:2;text-align:left"><span style="color:#5f6368;font-size:10.5pt"># The 'with' statement ensures the file is automatically closed.</span></p><p style="padding:0;margin:0;color:#000000;font-size:11pt;font-family:&quot;Arial&quot;;line-height:1.15;orphans:2;widows:2;text-align:left"><span style="color:#5f6368;font-size:10.5pt"># We create a file object and give it a temporary name, 'f'.</span></p><p style="padding:0;margin:0;color:#000000;font-size:11pt;font-family:&quot;Arial&quot;;line-height:1.15;orphans:2;widows:2;text-align:left"><span style="color:#8430ce;font-size:10.5pt">with</span><span style="color:#575b5f;font-size:10.5pt">&nbsp;</span><span style="color:#1967d2;font-size:10.5pt">open</span><span style="color:#575b5f;font-size:10.5pt">(</span><span style="color:#188038;font-size:10.5pt">"my_notes.txt"</span><span style="color:#575b5f;font-size:10.5pt">, </span><span style="color:#188038;font-size:10.5pt">"w"</span><span style="color:#575b5f;font-size:10.5pt">) </span><span style="color:#8430ce;font-size:10.5pt">as</span><span style="color:#575b5f;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:10.5pt;font-family:&quot;Arial&quot;;font-style:normal">&nbsp;f:</span></p><p style="padding:0;margin:0;color:#000000;font-size:11pt;font-family:&quot;Arial&quot;;line-height:1.15;orphans:2;widows:2;text-align:left"><span style="color:#575b5f;font-size:10.5pt">&nbsp; &nbsp; f.write(</span><span style="color:#188038;font-size:10.5pt">"Hello, file world!\n"</span><span style="color:#575b5f;font-size:10.5pt">) </span><span style="color:#5f6368;font-size:10.5pt"># \n is a newline character</span></p><p style="padding:0;margin:0;color:#000000;font-size:11pt;font-family:&quot;Arial&quot;;line-height:1.15;orphans:2;widows:2;text-align:left"><span style="color:#575b5f;font-size:10.5pt">&nbsp; &nbsp; f.write(</span><span style="color:#188038;font-size:10.5pt">"This is a second line.\n"</span><span style="color:#575b5f;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:10.5pt;font-family:&quot;Arial&quot;;font-style:normal">)</span></p><p style="padding:0;margin:0;color:#000000;font-size:11pt;font-family:&quot;Arial&quot;;line-height:1.15;orphans:2;widows:2;height:11pt;text-align:left"><span style="color:#575b5f;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:10.5pt;font-family:&quot;Arial&quot;;font-style:normal"></span></p><p style="padding:0;margin:0;color:#000000;font-size:11pt;font-family:&quot;Arial&quot;;line-height:1.15;orphans:2;widows:2;text-align:left"><span style="color:#5f6368;font-size:10.5pt"># Reading from a file</span></p><p style="padding:0;margin:0;color:#000000;font-size:11pt;font-family:&quot;Arial&quot;;line-height:1.15;orphans:2;widows:2;text-align:left"><span style="color:#8430ce;font-size:10.5pt">try</span><span style="color:#575b5f;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:10.5pt;font-family:&quot;Arial&quot;;font-style:normal">:</span></p><p style="padding:0;margin:0;color:#000000;font-size:11pt;font-family:&quot;Arial&quot;;line-height:1.15;orphans:2;widows:2;text-align:left"><span style="color:#575b5f;font-size:10.5pt">&nbsp; &nbsp; </span><span style="color:#8430ce;font-size:10.5pt">with</span><span style="color:#575b5f;font-size:10.5pt">&nbsp;</span><span style="color:#1967d2;font-size:10.5pt">open</span><span style="color:#575b5f;font-size:10.5pt">(</span><span style="color:#188038;font-size:10.5pt">"my_notes.txt"</span><span style="color:#575b5f;font-size:10.5pt">, </span><span style="color:#188038;font-size:10.5pt">"r"</span><span style="color:#575b5f;font-size:10.5pt">) </span><span style="color:#8430ce;font-size:10.5pt">as</span><span style="color:#575b5f;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:10.5pt;font-family:&quot;Arial&quot;;font-style:normal">&nbsp;f:</span></p><p style="padding:0;margin:0;color:#000000;font-size:11pt;font-family:&quot;Arial&quot;;line-height:1.15;orphans:2;widows:2;text-align:left"><span style="color:#575b5f;font-size:10.5pt">&nbsp; &nbsp; &nbsp; &nbsp; </span><span style="color:#5f6368;font-size:10.5pt"># .read() reads the entire file into a single string</span></p><p style="padding:0;margin:0;color:#000000;font-size:11pt;font-family:&quot;Arial&quot;;line-height:1.15;orphans:2;widows:2;text-align:left"><span style="color:#575b5f;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:10.5pt;font-family:&quot;Arial&quot;;font-style:normal">&nbsp; &nbsp; &nbsp; &nbsp; content = f.read()</span></p><p style="padding:0;margin:0;color:#000000;font-size:11pt;font-family:&quot;Arial&quot;;line-height:1.15;orphans:2;widows:2;text-align:left"><span style="color:#575b5f;font-size:10.5pt">&nbsp; &nbsp; &nbsp; &nbsp; print(</span><span style="color:#188038;font-size:10.5pt">"--- Reading entire file ---"</span><span style="color:#575b5f;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:10.5pt;font-family:&quot;Arial&quot;;font-style:normal">)</span></p><p style="padding:0;margin:0;color:#000000;font-size:11pt;font-family:&quot;Arial&quot;;line-height:1.15;orphans:2;widows:2;text-align:left"><span style="color:#575b5f;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:10.5pt;font-family:&quot;Arial&quot;;font-style:normal">&nbsp; &nbsp; &nbsp; &nbsp; print(content)</span></p><p style="padding:0;margin:0;color:#000000;font-size:11pt;font-family:&quot;Arial&quot;;line-height:1.15;orphans:2;widows:2;height:11pt;text-align:left"><span style="color:#575b5f;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:10.5pt;font-family:&quot;Arial&quot;;font-style:normal"></span></p><p style="padding:0;margin:0;color:#000000;font-size:11pt;font-family:&quot;Arial&quot;;line-height:1.15;orphans:2;widows:2;text-align:left"><span style="color:#575b5f;font-size:10.5pt">&nbsp; &nbsp; </span><span style="color:#8430ce;font-size:10.5pt">with</span><span style="color:#575b5f;font-size:10.5pt">&nbsp;</span><span style="color:#1967d2;font-size:10.5pt">open</span><span style="color:#575b5f;font-size:10.5pt">(</span><span style="color:#188038;font-size:10.5pt">"my_notes.txt"</span><span style="color:#575b5f;font-size:10.5pt">, </span><span style="color:#188038;font-size:10.5pt">"r"</span><span style="color:#575b5f;font-size:10.5pt">) </span><span style="color:#8430ce;font-size:10.5pt">as</span><span style="color:#575b5f;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:10.5pt;font-family:&quot;Arial&quot;;font-style:normal">&nbsp;f:</span></p><p style="padding:0;margin:0;color:#000000;font-size:11pt;font-family:&quot;Arial&quot;;line-height:1.15;orphans:2;widows:2;text-align:left"><span style="color:#575b5f;font-size:10.5pt">&nbsp; &nbsp; &nbsp; &nbsp; </span><span style="color:#5f6368;font-size:10.5pt"># .readlines() reads the file into a list of strings</span></p><p style="padding:0;margin:0;color:#000000;font-size:11pt;font-family:&quot;Arial&quot;;line-height:1.15;orphans:2;widows:2;text-align:left"><span style="color:#575b5f;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:10.5pt;font-family:&quot;Arial&quot;;font-style:normal">&nbsp; &nbsp; &nbsp; &nbsp; lines = f.readlines()</span></p><p style="padding:0;margin:0;color:#000000;font-size:11pt;font-family:&quot;Arial&quot;;line-height:1.15;orphans:2;widows:2;text-align:left"><span style="color:#575b5f;font-size:10.5pt">&nbsp; &nbsp; &nbsp; &nbsp; print(</span><span style="color:#188038;font-size:10.5pt">"--- Reading line by line ---"</span><span style="color:#575b5f;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:10.5pt;font-family:&quot;Arial&quot;;font-style:normal">)</span></p><p style="padding:0;margin:0;color:#000000;font-size:11pt;font-family:&quot;Arial&quot;;line-height:1.15;orphans:2;widows:2;text-align:left"><span style="color:#575b5f;font-size:10.5pt">&nbsp; &nbsp; &nbsp; &nbsp; </span><span style="color:#8430ce;font-size:10.5pt">for</span><span style="color:#575b5f;font-size:10.5pt">&nbsp;line </span><span style="color:#8430ce;font-size:10.5pt">in</span><span style="color:#575b5f;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:10.5pt;font-family:&quot;Arial&quot;;font-style:normal">&nbsp;lines:</span></p><p style="padding:0;margin:0;color:#000000;font-size:11pt;font-family:&quot;Arial&quot;;line-height:1.15;orphans:2;widows:2;text-align:left"><span style="color:#575b5f;font-size:10.5pt">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; print(line.strip()) </span><span style="color:#5f6368;font-size:10.5pt"># .strip() removes whitespace like \n</span></p><p style="padding:0;margin:0;color:#000000;font-size:11pt;font-family:&quot;Arial&quot;;line-height:1.15;orphans:2;widows:2;height:11pt;text-align:left"><span style="color:#575b5f;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:10.5pt;font-family:&quot;Arial&quot;;font-style:normal"></span></p><p style="padding:0;margin:0;color:#000000;font-size:11pt;font-family:&quot;Arial&quot;;line-height:1.15;orphans:2;widows:2;text-align:left"><span style="color:#8430ce;font-size:10.5pt">except</span><span style="color:#575b5f;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:10.5pt;font-family:&quot;Arial&quot;;font-style:normal">&nbsp;FileNotFoundError:</span></p><p style="padding:0;margin:0;color:#000000;font-size:11pt;font-family:&quot;Arial&quot;;line-height:1.15;orphans:2;widows:2;text-align:left"><span style="color:#575b5f;font-size:10.5pt">&nbsp; &nbsp; print(</span><span style="color:#188038;font-size:10.5pt">"The file was not found!"</span><span style="color:#575b5f;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:10.5pt;font-family:&quot;Arial&quot;;font-style:normal">)</span></p><p style="padding-top:0pt;margin:0;color:#000000;padding-left:0;font-size:11pt;padding-bottom:12pt;line-height:1.15;background-color:#f0f4f9;font-family:&quot;Arial&quot;;orphans:2;widows:2;height:11pt;text-align:left;padding-right:0"><span style="color:#575b5f;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:10.5pt;font-family:&quot;Arial&quot;;font-style:normal"></span></p><hr><p style="padding:0;margin:0;color:#000000;font-size:11pt;font-family:&quot;Arial&quot;;line-height:1.15;orphans:2;widows:2;height:11pt;text-align:left"><span style="color:#1b1c1d;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal"></span></p><h3 id="h.p3elbugn1vbk" style="padding-top:0pt;margin:0;color:#434343;padding-left:0;font-size:14pt;padding-bottom:6pt;line-height:1.15;page-break-after:avoid;font-family:&quot;Arial&quot;;orphans:2;widows:2;text-align:left;padding-right:0"><span style="color:#1b1c1d;font-weight:700;text-decoration:none;vertical-align:baseline;font-size:13pt;font-family:&quot;Arial&quot;;font-style:normal">Further Research</span></h3><ul class="lst-kix_qkywcp137m5p-0 start" style="padding:0;margin:0"><li style="padding-top:0pt;color:#000000;padding-left:0pt;font-size:11pt;padding-bottom:18pt;line-height:1.15;margin-right:0;margin-left:36pt;font-family:&quot;Arial&quot;;margin-top:0;orphans:2;margin-bottom:0;widows:2;text-align:left;padding-right:0"><span style="color:#1b1c1d;font-weight:700">Reading and Writing Files in Python (Real Python):</span><span style="color:#1b1c1d"><a href="https://www.google.com/url?q=https://realpython.com/read-write-files-python/&amp;sa=D&amp;source=editors&amp;ust=1786364336197044&amp;usg=AOvVaw0J0Ovzey2sK0CbxTkOjuo1" style="color:inherit;text-decoration:inherit">&nbsp;</a></span><span style="text-decoration-skip-ink:none;-webkit-text-decoration-skip:none;color:#0b57d0;text-decoration:underline"><a href="https://www.google.com/url?q=https://realpython.com/read-write-files-python/&amp;sa=D&amp;source=editors&amp;ust=1786364336197152&amp;usg=AOvVaw38-OWj3sGBWLG0PYNsEk4m" style="color:inherit;text-decoration:inherit">https://realpython.com/read-write-files-python/</a></span></li><li style="padding-top:0pt;color:#000000;padding-left:0pt;font-size:11pt;padding-bottom:18pt;line-height:1.15;margin-right:0;margin-left:36pt;font-family:&quot;Arial&quot;;margin-top:0;orphans:2;margin-bottom:0;widows:2;text-align:left;padding-right:0"><span style="background-color:#e9eef6;color:#575b5f;font-weight:700">open()</span><span style="color:#1b1c1d;font-weight:700">&nbsp;function (Official Python Docs):</span><span style="color:#1b1c1d"><a href="https://www.google.com/url?q=https://www.google.com/search?q%3Dhttps://docs.python.org/3/library/functions.html%2523open&amp;sa=D&amp;source=editors&amp;ust=1786364336197321&amp;usg=AOvVaw3641RU7OwXWSQZnpd5F2xr" style="color:inherit;text-decoration:inherit">&nbsp;</a></span><span style="text-decoration-skip-ink:none;-webkit-text-decoration-skip:none;color:#0b57d0;text-decoration:underline"><a href="https://www.google.com/url?q=https://www.google.com/search?q%3Dhttps://docs.python.org/3/library/functions.html%2523open&amp;sa=D&amp;source=editors&amp;ust=1786364336197425&amp;usg=AOvVaw3nyMvzEd-qdbr7QyncI7Eo" style="color:inherit;text-decoration:inherit">https://docs.python.org/3/library/functions.html#open</a></span></li></ul><hr><p style="padding:0;margin:0;color:#000000;font-size:11pt;font-family:&quot;Arial&quot;;line-height:1.15;orphans:2;widows:2;height:11pt;text-align:left"><span style="color:#1b1c1d;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal"></span></p><h2 id="h.dd8ewbr5keg8" style="padding-top:0pt;margin:0;color:#000000;padding-left:0;font-size:16pt;padding-bottom:6pt;line-height:1.15;page-break-after:avoid;font-family:&quot;Arial&quot;;orphans:2;widows:2;text-align:left;padding-right:0"><span style="color:#1b1c1d;font-weight:700;text-decoration:none;vertical-align:baseline;font-size:17pt;font-family:&quot;Arial&quot;;font-style:normal">Week 2: Working with CSV Files</span></h2><p style="padding-top:0pt;margin:0;color:#000000;padding-left:0;font-size:11pt;padding-bottom:12pt;font-family:&quot;Arial&quot;;line-height:1.15;orphans:2;widows:2;text-align:left;padding-right:0"><span style="color:#1b1c1d">Plain text is fine for simple notes, but most data is structured. </span><span style="color:#1b1c1d;font-weight:700">CSV (Comma-Separated Values)</span><span style="color:#1b1c1d;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal">&nbsp;is a very common text-based format for storing tabular data, like you'd see in a spreadsheet. Each line is a row, and commas separate the values in each column.</span></p><h3 id="h.7km7mr6yobz7" style="padding-top:0pt;margin:0;color:#434343;padding-left:0;font-size:14pt;padding-bottom:6pt;line-height:1.15;page-break-after:avoid;font-family:&quot;Arial&quot;;orphans:2;widows:2;text-align:left;padding-right:0"><span style="color:#1b1c1d;font-size:13pt;font-weight:700">Why Not Just Use </span><span style="background-color:#e9eef6;font-size:13pt;color:#575b5f;font-weight:700">.split(',')</span><span style="color:#1b1c1d;font-weight:700;text-decoration:none;vertical-align:baseline;font-size:13pt;font-family:&quot;Arial&quot;;font-style:normal">?</span></h3><p style="padding-top:0pt;margin:0;color:#000000;padding-left:0;font-size:11pt;padding-bottom:12pt;font-family:&quot;Arial&quot;;line-height:1.15;orphans:2;widows:2;text-align:left;padding-right:0"><span style="color:#1b1c1d">You </span><span style="color:#1b1c1d;font-style:italic">could</span><span style="color:#1b1c1d">&nbsp;read a </span><span style="background-color:#e9eef6;color:#575b5f">.csv</span><span style="color:#1b1c1d">&nbsp;file line by line and use </span><span style="background-color:#e9eef6;color:#575b5f">.split(',')</span><span style="color:#1b1c1d">, but this is fragile. What if a value itself contains a comma (e.g., "New York, NY")? The built-in </span><span style="background-color:#e9eef6;color:#575b5f">csv</span><span style="color:#1b1c1d;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal">&nbsp;module handles these edge cases for you.</span></p><h3 id="h.4v2vf54hsdw3" style="padding-top:0pt;margin:0;color:#434343;padding-left:0;font-size:14pt;padding-bottom:6pt;line-height:1.15;page-break-after:avoid;font-family:&quot;Arial&quot;;orphans:2;widows:2;text-align:left;padding-right:0"><span style="color:#1b1c1d;font-weight:700;text-decoration:none;vertical-align:baseline;font-size:13pt;font-family:&quot;Arial&quot;;font-style:normal">Reading from a CSV File</span></h3><p style="padding-top:0pt;margin:0;color:#000000;padding-left:0;font-size:11pt;padding-bottom:12pt;font-family:&quot;Arial&quot;;line-height:1.15;orphans:2;widows:2;text-align:left;padding-right:0"><span style="color:#1b1c1d">The </span><span style="background-color:#e9eef6;color:#575b5f">csv</span><span style="color:#1b1c1d;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal">&nbsp;module lets you treat each row in the file as a list of strings.</span></p><p style="padding-top:0pt;margin:0;color:#000000;padding-left:0;font-size:11pt;padding-bottom:12pt;font-family:&quot;Arial&quot;;line-height:1.15;orphans:2;widows:2;text-align:left;padding-right:0"><span style="color:#1b1c1d">Let's assume we have a file named </span><span style="background-color:#e9eef6;color:#575b5f">contacts.csv</span><span style="color:#1b1c1d;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal">&nbsp;with the following content:</span></p><p style="padding-top:0pt;margin:0;color:#000000;padding-left:0;font-size:11pt;padding-bottom:14pt;line-height:1.15;background-color:#f0f4f9;font-family:&quot;Arial&quot;;orphans:2;widows:2;text-align:left;padding-right:0"><span style="color:#575b5f;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;