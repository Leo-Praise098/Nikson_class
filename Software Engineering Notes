e-height:1.15;orphans:2;widows:2;text-align:left"><span style="color:#575b5f;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:10.5pt;font-family:&quot;Arial&quot;;font-style:normal">&nbsp; &nbsp; processes = []</span></p><p style="padding:0;margin:0;color:#000000;font-size:11pt;font-family:&quot;Arial&quot;;line-height:1.15;orphans:2;widows:2;height:11pt;text-align:left"><span style="color:#575b5f;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:10.5pt;font-family:&quot;Arial&quot;;font-style:normal"></span></p><p style="padding:0;margin:0;color:#000000;font-size:11pt;font-family:&quot;Arial&quot;;line-height:1.15;orphans:2;widows:2;text-align:left"><span style="color:#575b5f;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:10.5pt;font-family:&quot;Arial&quot;;font-style:normal">&nbsp; &nbsp; start_time = time.time()</span></p><p style="padding:0;margin:0;color:#000000;font-size:11pt;font-family:&quot;Arial&quot;;line-height:1.15;orphans:2;widows:2;text-align:left"><span style="color:#575b5f;font-size:10.5pt">&nbsp; &nbsp; </span><span style="color:#8430ce;font-size:10.5pt">for</span><span style="color:#575b5f;font-size:10.5pt">&nbsp;num </span><span style="color:#8430ce;font-size:10.5pt">in</span><span style="color:#575b5f;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:10.5pt;font-family:&quot;Arial&quot;;font-style:normal">&nbsp;numbers:</span></p><p style="padding:0;margin:0;color:#000000;font-size:11pt;font-family:&quot;Arial&quot;;line-height:1.15;orphans:2;widows:2;text-align:left"><span style="color:#575b5f;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:10.5pt;font-family:&quot;Arial&quot;;font-style:normal">&nbsp; &nbsp; &nbsp; &nbsp; process = multiprocessing.Process(target=perform_calculation, args=(num,))</span></p><p style="padding:0;margin:0;color:#000000;font-size:11pt;font-family:&quot;Arial&quot;;line-height:1.15;orphans:2;widows:2;text-align:left"><span style="color:#575b5f;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:10.5pt;font-family:&quot;Arial&quot;;font-style:normal">&nbsp; &nbsp; &nbsp; &nbsp; processes.append(process)</span></p><p style="padding:0;margin:0;color:#000000;font-size:11pt;font-family:&quot;Arial&quot;;line-height:1.15;orphans:2;widows:2;text-align:left"><span style="color:#575b5f;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:10.5pt;font-family:&quot;Arial&quot;;font-style:normal">&nbsp; &nbsp; &nbsp; &nbsp; process.start()</span></p><p style="padding:0;margin:0;color:#000000;font-size:11pt;font-family:&quot;Arial&quot;;line-height:1.15;orphans:2;widows:2;height:11pt;text-align:left"><span style="color:#575b5f;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:10.5pt;font-family:&quot;Arial&quot;;font-style:normal"></span></p><p style="padding:0;margin:0;color:#000000;font-size:11pt;font-family:&quot;Arial&quot;;line-height:1.15;orphans:2;widows:2;text-align:left"><span style="color:#575b5f;font-size:10.5pt">&nbsp; &nbsp; </span><span style="color:#8430ce;font-size:10.5pt">for</span><span style="color:#575b5f;font-size:10.5pt">&nbsp;process </span><span style="color:#8430ce;font-size:10.5pt">in</span><span style="color:#575b5f;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:10.5pt;font-family:&quot;Arial&quot;;font-style:normal">&nbsp;processes:</span></p><p style="padding:0;margin:0;color:#000000;font-size:11pt;font-family:&quot;Arial&quot;;line-height:1.15;orphans:2;widows:2;text-align:left"><span style="color:#575b5f;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:10.5pt;font-family:&quot;Arial&quot;;font-style:normal">&nbsp; &nbsp; &nbsp; &nbsp; process.join()</span></p><p style="padding:0;margin:0;color:#000000;font-size:11pt;font-family:&quot;Arial&quot;;line-height:1.15;orphans:2;widows:2;height:11pt;text-align:left"><span style="color:#575b5f;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:10.5pt;font-family:&quot;Arial&quot;;font-style:normal"></span></p><p style="padding:0;margin:0;color:#000000;font-size:11pt;font-family:&quot;Arial&quot;;line-height:1.15;orphans:2;widows:2;text-align:left"><span style="color:#575b5f;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:10.5pt;font-family:&quot;Arial&quot;;font-style:normal">&nbsp; &nbsp; duration = time.time() - start_time</span></p><p style="padding:0;margin:0;color:#000000;font-size:11pt;font-family:&quot;Arial&quot;;line-height:1.15;orphans:2;widows:2;text-align:left"><span style="color:#575b5f;font-size:10.5pt">&nbsp; &nbsp; print(</span><span style="color:#188038;font-size:10.5pt">f"Parallel run took </span><span style="color:#1b1c1d;font-size:10.5pt">{duration:</span><span style="color:#b55908;font-size:10.5pt">.2</span><span style="color:#1b1c1d;font-size:10.5pt">f}</span><span style="color:#188038;font-size:10.5pt">&nbsp;seconds"</span><span style="color:#575b5f;font-size:10.5pt">) </span><span style="color:#5f6368;font-size:10.5pt"># Takes ~2 seconds on a multi-core machine</span></p><p style="padding-top:0pt;margin:0;color:#000000;padding-left:0;font-size:11pt;padding-bottom:12pt;line-height:1.15;background-color:#f0f4f9;font-family:&quot;Arial&quot;;orphans:2;widows:2;height:11pt;text-align:left;padding-right:0"><span style="color:#575b5f;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:10.5pt;font-family:&quot;Arial&quot;;font-style:normal"></span></p><p style="padding-top:0pt;margin:0;color:#000000;padding-left:0;font-size:11pt;padding-bottom:12pt;font-family:&quot;Arial&quot;;line-height:1.15;orphans:2;widows:2;text-align:left;padding-right:0"><span style="color:#1b1c1d;font-weight:700">Note:</span><span style="color:#1b1c1d">&nbsp;The </span><span style="background-color:#e9eef6;color:#575b5f">if __name__ == '__main__':</span><span style="color:#1b1c1d">&nbsp;guard is essential for </span><span style="background-color:#e9eef6;color:#575b5f">multiprocessing</span><span style="color:#1b1c1d;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal">&nbsp;to work correctly on some platforms.</span></p><h3 id="h.ooc7tev0ducs" style="padding-top:0pt;margin:0;color:#434343;padding-left:0;font-size:14pt;padding-bottom:6pt;line-height:1.15;page-break-after:avoid;font-family:&quot;Arial&quot;;orphans:2;widows:2;text-align:left;padding-right:0"><span style="color:#1b1c1d;font-weight:700;text-decoration:none;vertical-align:baseline;font-size:13pt;font-family:&quot;Arial&quot;;font-style:normal">When to Use Multiprocessing</span></h3><ul class="lst-kix_57lfqn6u17tb-0 start" style="padding:0;margin:0"><li style="padding-top:0pt;color:#000000;padding-left:0pt;font-size:11pt;padding-bottom:18pt;line-height:1.15;margin-right:0;margin-left:36pt;font-family:&quot;Arial&quot;;margin-top:0;orphans:2;margin-bottom:0;widows:2;text-align:left;padding-right:0"><span style="color:#1b1c1d;font-weight:700">Best for:</span><span style="color:#1b1c1d;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal">&nbsp;CPU-bound tasks that can be broken down into independent pieces of work.</span></li><li style="padding-top:0pt;color:#000000;padding-left:0pt;font-size:11pt;padding-bottom:18pt;line-height:1.15;margin-right:0;margin-left:36pt;font-family:&quot;Arial&quot;;margin-top:0;orphans:2;margin-bottom:0;widows:2;text-align:left;padding-right:0"><span style="color:#1b1c1d;font-weight:700">Not for:</span><span style="color:#1b1c1d;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal">&nbsp;I/O-bound tasks (it works, but the overhead of creating processes is much higher than for threads, making it less efficient).</span></li></ul><hr><p style="padding:0;margin:0;color:#000000;font-size:11pt;font-family:&quot;Arial&quot;;line-height:1.15;orphans:2;widows:2;height:11pt;text-align:left"><span style="color:#1b1c1d;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal"></span></p><h3 id="h.lefnylmcebrk" style="padding-top:0pt;margin:0;color:#434343;padding-left:0;font-size:14pt;padding-bottom:6pt;line-height:1.15;page-break-after:avoid;font-family:&quot;Arial&quot;;orphans:2;widows:2;text-align:left;padding-right:0"><span style="color:#1b1c1d;font-weight:700;text-decoration:none;vertical-align:baseline;font-size:13pt;font-family:&quot;Arial&quot;;font-style:normal">Further Research</span></h3><ul class="lst-kix_bcdy8kffht1-0 start" style="padding:0;margin:0"><li style="padding-top:0pt;color:#000000;padding-left:0pt;font-size:11pt;padding-bottom:18pt;line-height:1.15;margin-right:0;margin-left:36pt;font-family:&quot;Arial&quot;;margin-top:0;orphans:2;margin-bottom:0;widows:2;text-align:left;padding-right:0"><span style="color:#1b1c1d;font-weight:700">An Introduction to Multiprocessing in Python (Real Python):</span><span style="color:#1b1c1d"><a href="https://www.google.com/url?q=https://realpython.com/python-multiprocessing/&amp;sa=D&amp;source=editors&amp;ust=1786364336331433&amp;usg=AOvVaw0_0gXC4gt11aFUXidcIAAL" style="color:inherit;text-decoration:inherit">&nbsp;</a></span><span style="text-decoration-skip-ink:none;-webkit-text-decoration-skip:none;color:#0b57d0;text-decoration:underline"><a href="https://www.google.com/url?q=https://realpython.com/python-multiprocessing/&amp;sa=D&amp;source=editors&amp;ust=1786364336331539&amp;usg=AOvVaw3gq8mJ-03JS8jX0R6b5GBs" style="color:inherit;text-decoration:inherit">https://realpython.com/python-multiprocessing/</a></span></li><li style="padding-top:0pt;color:#000000;padding-left:0pt;font-size:11pt;padding-bottom:18pt;line-height:1.15;margin-right:0;margin-left:36pt;font-family:&quot;Arial&quot;;margin-top:0;orphans:2;margin-bottom:0;widows:2;text-align:left;padding-right:0"><span style="background-color:#e9eef6;color:#575b5f;font-weight:700">multiprocessing</span><span style="color:#1b1c1d;font-weight:700">&nbsp;‚Äî Process-based parallelism (Official Python Docs):</span><span style="color:#1b1c1d"><a href="https://www.google.com/url?q=https://docs.python.org/3/library/multiprocessing.html&amp;sa=D&amp;source=editors&amp;ust=1786364336331698&amp;usg=AOvVaw07cKVM8HqZ-Qtc4CFeG-p1" style="color:inherit;text-decoration:inherit">&nbsp;</a></span><span style="text-decoration-skip-ink:none;-webkit-text-decoration-skip:none;color:#0b57d0;text-decoration:underline"><a href="https://www.google.com/url?q=https://docs.python.org/3/library/multiprocessing.html&amp;sa=D&amp;source=editors&amp;ust=1786364336331793&amp;usg=AOvVaw36T9knyfO4KVvymbhvrHXv" style="color:inherit;text-decoration:inherit">https://docs.python.org/3/library/multiprocessing.html</a></span></li></ul><hr><p style="padding:0;margin:0;color:#000000;font-size:11pt;font-family:&quot;Arial&quot;;line-height:1.15;orphans:2;widows:2;height:11pt;text-align:left"><span style="color:#1b1c1d;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal"></span></p><h2 id="h.aqrwfrkjbgwu" style="padding-top:0pt;margin:0;color:#000000;padding-left:0;font-size:16pt;padding-bottom:6pt;line-height:1.15;page-break-after:avoid;font-family:&quot;Arial&quot;;orphans:2;widows:2;text-align:left;padding-right:0"><span style="color:#1b1c1d;font-size:17pt;font-weight:700">Week 4: Asynchronous Programming with </span><span style="background-color:#e9eef6;color:#575b5f;font-weight:700;text-decoration:none;vertical-align:baseline;font-size:17pt;font-family:&quot;Arial&quot;;font-style:normal">asyncio</span></h2><p style="padding-top:0pt;margin:0;color:#000000;padding-left:0;font-size:11pt;padding-bottom:12pt;font-family:&quot;Arial&quot;;line-height:1.15;orphans:2;widows:2;text-align:left;padding-right:0"><span style="background-color:#e9eef6;color:#575b5f;font-weight:700">asyncio</span><span style="color:#1b1c1d">&nbsp;is Python's modern framework for writing single-threaded concurrent code using </span><span style="color:#1b1c1d;font-weight:700">coroutines</span><span style="color:#1b1c1d">. It is another powerful tool for managing </span><span style="color:#1b1c1d;font-weight:700">I/O-bound tasks</span><span style="color:#1b1c1d">, but it uses a different approach from threading called </span><span style="color:#1b1c1d;font-weight:700">cooperative multitasking</span><span style="color:#1b1c1d;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal">.</span></p><h3 id="h.xeasv3se0iui" style="padding-top:0pt;margin:0;color:#434343;padding-left:0;font-size:14pt;padding-bottom:6pt;line-height:1.15;page-break-after:avoid;font-family:&quot;Arial&quot;;orphans:2;widows:2;text-align:left;padding-right:0"><span style="color:#1b1c1d;font-size:13pt;font-weight:700">How </span><span style="background-color:#e9eef6;font-size:13pt;color:#575b5f;font-weight:700">asyncio</span><span style="color:#1b1c1d;font-weight:700;text-decoration:none;vertical-align:baseline;font-size:13pt;font-family:&quot;Arial&quot;;font-style:normal">&nbsp;Works</span></h3><p style="padding-top:0pt;margin:0;color:#000000;padding-left:0;font-size:11pt;padding-bottom:6pt;font-family:&quot;Arial&quot;;line-height:1.15;orphans:2;widows:2;text-align:left;padding-right:0"><span style="background-color:#e9eef6;color:#575b5f">asyncio</span><span style="color:#1b1c1d">&nbsp;uses an </span><span style="color:#1b1c1d;font-weight:700">event loop</span><span style="color:#1b1c1d;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal">&nbsp;within a single thread. Instead of the OS switching between threads, the program itself explicitly says, "I'm about to do something that involves waiting, so I'm yielding control. Event loop, feel free to run something else while I wait."</span></p><ul class="lst-kix_f01gsruue1yb-0 start" style="padding:0;margin:0"><li style="padding-top:0pt;color:#000000;padding-left:0pt;font-size:11pt;padding-bottom:18pt;line-height:1.15;margin-right:0;margin-left:36pt;font-family:&quot;Arial&quot;;margin-top:0;orphans:2;margin-bottom:0;widows:2;text-align:left;padding-right:0"><span style="color:#1b1c1d;font-weight:700">Analogy:</span><span style="color:#1b1c1d">&nbsp;The single chef üßë‚Äçüç≥ is back, but now they are an </span><span style="background-color:#e9eef6;color:#575b5f">async</span><span style="color:#1b1c1d">&nbsp;chef. They put a dish in the oven (an </span><span style="background-color:#e9eef6;color:#575b5f">await</span><span style="color:#1b1c1d">&nbsp;call to an I/O operation). Instead of just waiting, they explicitly tell their assistant (the </span><span style="color:#1b1c1d;font-weight:700">event loop</span><span style="color:#1b1c1d">), "The oven will take 20 minutes; let me know when it's done. In the meantime, I'll start chopping vegetables." The chef </span><span style="color:#1b1c1d;font-style:italic">cooperatively</span><span style="color:#1b1c1d;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal">&nbsp;gives up control and only gets it back when the event they're waiting for is ready.</span></li></ul><h3 id="h.qgt10h1ord1y" style="padding-top:0pt;margin:0;color:#434343;padding-left:0;font-size:14pt;padding-bottom:6pt;line-height:1.15;page-break-after:avoid;font-family:&quot;Arial&quot;;orphans:2;widows:2;text-align:left;padding-right:0"><span style="color:#1b1c1d;font-size:13pt;font-weight:700">The </span><span style="background-color:#e9eef6;font-size:13pt;color:#575b5f;font-weight:700">async</span><span style="color:#1b1c1d;font-size:13pt;font-weight:700">&nbsp;and </span><span style="background-color:#e9eef6;font-size:13pt;color:#575b5f;font-weight:700">await</span><span style="color:#1b1c1d;font-weight:700;text-decoration:none;vertical-align:baseline;font-size:13pt;font-family:&quot;Arial&quot;;font-style:normal">&nbsp;Keywords</span></h3><ul class="lst-kix_nsulyn8jvkzw-0 start" style="padding:0;margin:0"><li style="padding-top:0pt;color:#000000;padding-left:0pt;font-size:11pt;padding-bottom:18pt;line-height:1.15;margin-right:0;margin-left:36pt;font-family:&quot;Arial&quot;;margin-top:0;orphans:2;margin-bottom:0;widows:2;text-align:left;padding-right:0"><span style="background-color:#e9eef6;color:#575b5f">async def</span><span style="color:#1b1c1d">: This declares a function as a </span><span style="color:#1b1c1d;font-weight:700">coroutine</span><span style="color:#1b1c1d;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal">. You can think of it as a special function that can be paused and resumed.</span></li><li style="padding-top:0pt;color:#000000;padding-left:0pt;font-size:11pt;padding-bottom:18pt;line-height:1.15;margin-right:0;margin-left:36pt;font-family:&quot;Arial&quot;;margin-top:0;orphans:2;margin-bottom:0;widows:2;text-align:left;padding-right:0"><span style="background-color:#e9eef6;color:#575b5f">await</span><span style="color:#1b1c1d">: This keyword is used inside an </span><span style="background-color:#e9eef6;color:#575b5f">async</span><span style="color:#1b1c1d">&nbsp;function to call another coroutine. It essentially says, "Pause this function here, let the event loop run other things, and wake me up when this </span><span style="background-color:#e9eef6;color:#575b5f">await</span><span style="color:#1b1c1d;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal">ed task is complete."</span></li></ul><h3 id="h.ii4hl5rvfrat" style="padding-top:0pt;margin:0;color:#434343;padding-left:0;font-size:14pt;padding-bottom:6pt;line-height:1.15;page-break-after:avoid;font-family:&quot;Arial&quot;;orphans:2;widows:2;text-align:left;padding-right:0"><span style="color:#1b1c1d;font-size:13pt;font-weight:700">Example with </span><span style="background-color:#e9eef6;color:#575b5f;font-weight:700;text-decoration:none;vertical-align:baseline;font-size:13pt;font-family:&quot;Arial&quot;;font-style:normal">asyncio</span></h3><p style="padding-top:0pt;margin:0;color:#000000;padding-left:0;font-size:11pt;padding-bottom:14pt;line-height:1.15;background-color:#f0f4f9;font-family:&quot;Arial&quot;;orphans:2;widows:2;text-align:left;padding-right:0"><span style="color:#575b5f;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:&quot;Arial&quot;;font-style:normal">Python</span></p><p style="padding:0;margin:0;color:#000000;font-size:11pt;font-family:&quot;Arial&quot;;line-height:1.15;orphans:2;widows:2;text-align:left"><span style="color:#8430ce;font-size:10.5pt">import</span><span style="color:#575b5f;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:10.5pt;font-family:&quot;Arial&quot;;font-style:normal">&nbsp;asyncio</span></p><p style="padding:0;margin:0;color:#000000;font-size:11pt;font-family:&quot;Arial&quot;;line-height:1.15;orphans:2;widows:2;text-align:left"><span style="color:#8430ce;font-size:10.5pt">import</span><span style="color:#575b5f;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:10.5pt;font-family:&quot;Arial&quot;;font-style:normal">&nbsp;time</span></p><p style="padding:0;margin:0;color:#000000;font-size:11pt;font-family:&quot;Arial&quot;;line-height:1.15;orphans:2;widows:2;height:11pt;text-align:left"><span style="color:#575b5f;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:10.5pt;font-family:&quot;Arial&quot;;font-style:normal"></span></p><p style="padding:0;margin:0;color:#000000;font-size:11pt;font-family:&quot;Arial&quot;;line-height:1.15;orphans:2;widows:2;text-align:left"><span st