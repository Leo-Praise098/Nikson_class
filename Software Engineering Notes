al&quot;;line-height:1.15;orphans:2;widows:2;text-align:left"><span style="color:#575b5f;font-size:10.5pt">&nbsp; &nbsp; print(</span><span style="color:#188038;font-size:10.5pt">f"Finished download for </span><span style="color:#1b1c1d;font-size:10.5pt">{url}</span><span style="color:#188038;font-size:10.5pt">"</span><span style="color:#575b5f;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:10.5pt;font-family:&quot;Arial&quot;;font-style:normal">)</span></p><p style="padding:0;margin:0;color:#000000;font-size:11pt;font-family:&quot;Arial&quot;;line-height:1.15;orphans:2;widows:2;height:11pt;text-align:left"><span style="color:#575b5f;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:10.5pt;font-family:&quot;Arial&quot;;font-style:normal"></span></p><p style="padding:0;margin:0;color:#000000;font-size:11pt;font-family:&quot;Arial&quot;;line-height:1.15;orphans:2;widows:2;text-align:left"><span style="color:#8430ce;font-size:10.5pt">async</span><span style="color:#575b5f;font-size:10.5pt">&nbsp;</span><span style="color:#8430ce;font-size:10.5pt">def</span><span style="color:#575b5f;font-size:10.5pt">&nbsp;</span><span style="color:#996900;font-size:10.5pt">main</span><span style="color:#575b5f;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:10.5pt;font-family:&quot;Arial&quot;;font-style:normal">():</span></p><p style="padding:0;margin:0;color:#000000;font-size:11pt;font-family:&quot;Arial&quot;;line-height:1.15;orphans:2;widows:2;text-align:left"><span style="color:#575b5f;font-size:10.5pt">&nbsp; &nbsp; </span><span style="color:#5f6368;font-size:10.5pt"># --- Concurrent (With asyncio) ---</span></p><p style="padding:0;margin:0;color:#000000;font-size:11pt;font-family:&quot;Arial&quot;;line-height:1.15;orphans:2;widows:2;text-align:left"><span style="color:#575b5f;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:10.5pt;font-family:&quot;Arial&quot;;font-style:normal">&nbsp; &nb